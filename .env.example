SMTP_PORT=465
SMTP_USER=ornek@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
EMAIL_FROM="Game Lover <ornek@gmail.com>"
# Yeni sipariş / teklif bildirimlerinin gideceği adres
ADMIN_NOTIFY_EMAIL=ornek@gmail.com

# Sitenin adresi (e-posta ve paylaşım linkleri için)
